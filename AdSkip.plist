<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!-- com.apple.Security is the documented compatibility target for the
		     old "load in all processes" behavior. The tweak still self-gates
		     by bundle ID and user settings at runtime. -->
		<key>Bundles</key>
		<array>
			<string>com.apple.Security</string>
		</array>
	</dict>
</dict>
</plist>
